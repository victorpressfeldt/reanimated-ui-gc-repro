{
  "name": "reanimated-ui-gc-repro",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "expo start",
    "prebuild": "expo prebuild --platform android --clean",
    "apk": "cd android && ./gradlew assembleRelease -PreactNativeArchitectures=arm64-v8a",
    "typecheck": "tsc --noEmit"
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native-worklets",
        "react-native-reanimated"
      ]
    }
  },
  "dependencies": {
    "expo": "58.0.26",
    "expo-constants": "58.0.16",
    "expo-linking": "58.0.17",
    "expo-router": "58.0.32",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-reanimated": "4.8.0",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "4.30.1",
    "react-native-worklets": "0.14.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.0",
    "typescript": "~6.0.3"
  }
}
