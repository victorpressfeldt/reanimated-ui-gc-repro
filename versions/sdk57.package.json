{
  "name": "reanimated-ui-gc-repro",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "expo start",
    "prebuild": "expo prebuild --platform android --clean",
    "apk": "cd android && ./gradlew assembleRelease -PreactNativeArchitectures=arm64-v8a",
    "typecheck": "tsc --noEmit"
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native-worklets",
        "react-native-reanimated"
      ]
    }
  },
  "dependencies": {
    "expo": "57.0.7",
    "expo-constants": "57.0.6",
    "expo-linking": "57.0.3",
    "expo-router": "57.0.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-worklets": "0.10.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.4",
    "babel-preset-expo": "~57.0.0",
    "typescript": "~6.0.3"
  }
}
